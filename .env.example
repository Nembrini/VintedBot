# Copy to .env and adjust. All variables are optional (defaults shown).

# Vinted national domain to target (session cookies are per-domain)
VINTEDBOT_BASE_URL=https://www.vinted.it

# Max outgoing HTTP requests per minute — keep low to stay under the radar
VINTEDBOT_RATE_LIMIT_PER_MINUTE=12

# Read timeout per richiesta (seconds)
VINTEDBOT_REQUEST_TIMEOUT_SECONDS=30

# Connect timeout (seconds)
VINTEDBOT_CONNECT_TIMEOUT_SECONDS=10

# DEBUG | INFO | WARNING | ERROR | CRITICAL
VINTEDBOT_LOG_LEVEL=INFO

# true → one JSON object per log line (production); false → pretty console
VINTEDBOT_LOG_JSON=false
