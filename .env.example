# Copia in .env e personalizza. Tutte le variabili sono opzionali (default mostrati).

# Dominio nazionale Vinted (i cookie di sessione sono per-dominio)
VINTEDBOT_BASE_URL=https://www.vinted.it

# Massimo richieste HTTP al minuto — tenere basso per restare sotto i radar
VINTEDBOT_RATE_LIMIT_PER_MINUTE=12

# Read timeout per richiesta (secondi)
VINTEDBOT_REQUEST_TIMEOUT_SECONDS=30

# Connect timeout (secondi)
VINTEDBOT_CONNECT_TIMEOUT_SECONDS=10

# File SQLite (la directory viene creata alla prima apertura)
VINTEDBOT_DB_PATH=data/vintedbot.db

# Limiti di default per una ricerca paginata
VINTEDBOT_SEARCH_MAX_PAGES=5
VINTEDBOT_SEARCH_MAX_ITEMS=200

# Motore di stima prezzo (step 4): sotto questo campione lo score è "n/d"
VINTEDBOT_PRICING_MIN_SAMPLE_SIZE=8
# Sconto vs mediana che vale il massimo della curva (0.60 = -60%)
VINTEDBOT_PRICING_MAX_DISCOUNT=0.60
# Shrinkage: confidence = n / (n + K)
VINTEDBOT_PRICING_CONFIDENCE_K=10
# Finestra temporale delle osservazioni usate per la stima (giorni)
VINTEDBOT_PRICING_MAX_AGE_DAYS=90

# Anti-valanga: massimo notifiche Telegram per esecuzione (le eccedenti
# restano in coda e vengono smaltite ai giri successivi)
VINTEDBOT_MAX_NOTIFICATIONS_PER_RUN=10

# Pausa tra un invio Telegram e il successivo (secondi)
VINTEDBOT_NOTIFY_PAUSE_SECONDS=1.0

# Notifiche Telegram (opzionali: senza, il comando search funziona comunque).
# Accettati anche senza prefisso: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID.
VINTEDBOT_TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VINTEDBOT_TELEGRAM_CHAT_ID=123456789

# DEBUG | INFO | WARNING | ERROR | CRITICAL
VINTEDBOT_LOG_LEVEL=INFO

# true → una riga JSON per log (produzione); false → console leggibile
VINTEDBOT_LOG_JSON=false
