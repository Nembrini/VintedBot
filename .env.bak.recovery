# Copy to .env and adjust. All variables are optional (defaults shown).

# Vinted national domain to target (session cookies are per-domain)
VINTEDBOT_BASE_URL=https://www.vinted.it

# Max outgoing HTTP requests per minute â€” keep low to stay under the radar
VINTEDBOT_RATE_LIMIT_PER_MINUTE=12

# Read timeout per richiesta (seconds)
VINTEDBOT_REQUEST_TIMEOUT_SECONDS=30

# Connect timeout (seconds)
VINTEDBOT_CONNECT_TIMEOUT_SECONDS=10

# File SQLite (la directory viene creata alla prima apertura)
# Tutto (db, logs/, lock, health.json) sotto la data dir del progetto.
# Percorso ASSOLUTO: sotto Task Scheduler la cwd non e' quella del progetto.
VINTEDBOT_DATA_DIR=C:\Users\filip\VintedBot\data
ILIPVINTEDBOTDATA

# Limiti di default per una ricerca paginata
VINTEDBOT_SEARCH_MAX_PAGES=5
VINTEDBOT_SEARCH_MAX_ITEMS=200

# DEBUG | INFO | WARNING | ERROR | CRITICAL
VINTEDBOT_LOG_LEVEL=INFO

# true â†’ one JSON object per log line (production); false â†’ pretty console
VINTEDBOT_LOG_JSON=false

TELEGRAM_BOT_TOKEN=8602500222:AAFCPCr7ZprKAjBQOgtjv5X4EOcsggPvDYg
TELEGRAM_CHAT_ID=696061308
# Taratura curva affare (collaudo 4.3)
VINTEDBOT_PRICING_MAX_DISCOUNT=0.50

